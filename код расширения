      menuIconURI: iconUrl,
      blockIconURI: iconUrl,
      color1: '#0088cc',
      color2: '#006699',
      color3: '#004466',
      blocks: [
        // ==========================================
        { blockType: Scratch.BlockType.LABEL, text: '⚙️ Подключение' },
        {
          opcode: 'setToken',
          blockType: Scratch.BlockType.COMMAND,
          text: 'установить токен бота [TOKEN]',
          arguments: { TOKEN: { type: Scratch.ArgumentType.STRING, defaultValue: 'Вставь_токен' } }
        },
        {
          opcode: 'setDefaultChatId',
          blockType: Scratch.BlockType.COMMAND,
          text: 'установить чат по умолчанию [CHAT_ID]',
          arguments: { CHAT_ID: { type: Scratch.ArgumentType.STRING, defaultValue: 'ID_чата' } }
        },
        {
          opcode: 'checkConnection',
          blockType: Scratch.BlockType.REPORTER,
          text: 'проверить подключение к API'
        },

        // ==========================================
        { blockType: Scratch.BlockType.LABEL, text: '📤 Отправка сообщений' },
        {
          opcode: 'sendMessage',
          blockType: Scratch.BlockType.COMMAND,
          text: 'отправить сообщение [TEXT] в чат [CHAT_ID]',
          arguments: {
            TEXT: { type: Scratch.ArgumentType.STRING, defaultValue: 'Привет!' },
            CHAT_ID: { type: Scratch.ArgumentType.STRING, defaultValue: '' }
          }
        },
        {
          opcode: 'sendPhoto',
          blockType: Scratch.BlockType.COMMAND,
          text: 'отправить фото по URL [URL] в чат [CHAT_ID]',
          arguments: {
            URL: { type: Scratch.ArgumentType.STRING, defaultValue: 'https://picsum.photos/200' },
            CHAT_ID: { type: Scratch.ArgumentType.STRING, defaultValue: '' }
          }
        },
        {
          opcode: 'sendSpriteImage',
          blockType: Scratch.BlockType.COMMAND,
          text: 'отправить картинку спрайта [SPRITE] в чат [CHAT_ID]',
          arguments: {
            SPRITE: { type: Scratch.ArgumentType.STRING, defaultValue: '' },
            CHAT_ID: { type: Scratch.ArgumentType.STRING, defaultValue: '' }
          }
        },
        {
          opcode: 'sendStageImage',
          blockType: Scratch.BlockType.COMMAND,
          text: 'отправить снимок всей сцены в чат [CHAT_ID]',
          arguments: {
            CHAT_ID: { type: Scratch.ArgumentType.STRING, defaultValue: '' }
          }
        },

        // ==========================================
        { blockType: Scratch.BlockType.LABEL, text: '🔨 Конструктор меню (кнопки)' },
        { opcode: 'keyboardClear', blockType: Scratch.BlockType.COMMAND, text: 'очистить кнопки меню' },
        { opcode: 'keyboardNewRow', blockType: Scratch.BlockType.COMMAND, text: 'новая строка кнопок' },
        {
          opcode: 'keyboardAddCallback',
          blockType: Scratch.BlockType.COMMAND,
          text: 'добавить кнопку [TEXT] с данными [DATA]',
          arguments: {
            TEXT: { type: Scratch.ArgumentType.STRING, defaultValue: 'Нажми меня' },
            DATA: { type: Scratch.ArgumentType.STRING, defaultValue: 'button_1' }
          }
        },
        {
          opcode: 'keyboardAddUrl',
          blockType: Scratch.BlockType.COMMAND,
          text: 'добавить кнопку-ссылку [TEXT] на [URL]',
          arguments: {
            TEXT: { type: Scratch.ArgumentType.STRING, defaultValue: 'Открыть сайт' },
            URL: { type: Scratch.ArgumentType.STRING, defaultValue: 'https://turbowarp.org' }
          }
        },
        { opcode: 'keyboardCount', blockType: Scratch.BlockType.REPORTER, text: 'количество кнопок в меню' },
        {
          opcode: 'sendKeyboard',
          blockType: Scratch.BlockType.COMMAND,
          text: 'отправить сообщение [TEXT] с меню в чат [CHAT_ID]',
          arguments: {
            TEXT: { type: Scratch.ArgumentType.STRING, defaultValue: 'Выберите действие:' },
