class TelegramBotExtension {
  constructor() {
    this.token = '';
    this.defaultChatId = '';
    this.keyboard = [];

    this.lastUpdateId = 0;
    this.messageQueue = [];
    this.pollingInterval = null;
    this.isPolling = false;

    this.callbackQueue = [];
    this.lastConsumedCallback = null;
  }

